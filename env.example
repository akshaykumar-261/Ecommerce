# Currency the platform charges in, and therefore the currency vendor payouts
# are denominated in. Must be a currency your Stripe account can settle in,
# otherwise every transfer fails with a currency mismatch.
STRIPE_CURRENCY=inr
# From `stripe listen` (dev) or the endpoint's signing secret in the Stripe Dashboard.
# Required by POST /stripe/webhook — without it every event is rejected as unsigned.
STRIPE_WEBHOOK_SECRET=""